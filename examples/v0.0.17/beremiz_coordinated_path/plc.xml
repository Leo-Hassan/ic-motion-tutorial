              </type>
            </variable>
            <variable name="AxisEnable">
              <type>
                <BOOL/>
              </type>
            </variable>
            <variable name="GroupEnableRequest">
              <type>
                <BOOL/>
              </type>
            </variable>
            <variable name="PathRequest">
              <type>
                <BOOL/>
              </type>
            </variable>
            <variable name="GroupStopRequest">
              <type>
                <BOOL/>
              </type>
            </variable>
            <variable name="UseBadRecipe">
              <type>
                <BOOL/>
              </type>
            </variable>
            <variable name="UseLimitRecipe">
              <type>
                <BOOL/>
              </type>
            </variable>
            <variable name="UseDegenerateRecipe">
              <type>
                <BOOL/>
              </type>
            </variable>
            <variable name="UseNonTangentRecipe">
              <type>
                <BOOL/>
              </type>
            </variable>
          </localVars>
        </interface>
        <body>
          <ST>
            <xhtml:p><![CDATA[PowerX(Axis := AxisX, Enable := AxisEnable);
PowerY(Axis := AxisY, Enable := AxisEnable);
GroupEnable(AxesGroup := Group_XY, Execute := GroupEnableRequest);

IF UseBadRecipe THEN
    ActiveRecipe := 0;
ELSIF UseLimitRecipe THEN
    ActiveRecipe := Path_Limit;
ELSIF UseDegenerateRecipe THEN
    ActiveRecipe := Path_Degenerate;
ELSIF UseNonTangentRecipe THEN
    ActiveRecipe := Path_NonTangent;
ELSE
    ActiveRecipe := Path_Mixed;
END_IF;

CoordinatedPath(AxesGroup := Group_XY, PathRecipe := ActiveRecipe,
                Execute := PathRequest);
GroupStop(AxesGroup := Group_XY, Execute := GroupStopRequest);
]]></xhtml:p>
          </ST>
        </body>
