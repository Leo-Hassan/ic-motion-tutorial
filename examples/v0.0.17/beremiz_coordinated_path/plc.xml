    <pous>
      <pou name="MAIN" pouType="program">
        <interface>
          <externalVars>
            <variable name="AxisX">
              <type>
                <derived name="AXIS_REF"/>
              </type>
            </variable>
            <variable name="AxisY">
              <type>
                <derived name="AXIS_REF"/>
              </type>
            </variable>
            <variable name="Group_XY">
              <type>
                <derived name="AXIS_GROUP_REF"/>
              </type>
            </variable>
            <variable name="Path_Mixed">
              <type>
                <derived name="PATH_RECIPE_REF"/>
              </type>
            </variable>
            <variable name="Path_Limit">
              <type>
                <derived name="PATH_RECIPE_REF"/>
