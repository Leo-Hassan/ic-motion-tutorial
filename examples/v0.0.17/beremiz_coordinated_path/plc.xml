            <variable name="Path_Degenerate">
              <type>
                <derived name="PATH_RECIPE_REF"/>
              </type>
            </variable>
            <variable name="Path_NonTangent">
              <type>
                <derived name="PATH_RECIPE_REF"/>
              </type>
            </variable>
          </externalVars>
          <localVars>
            <variable name="ActiveRecipe">
              <type>
                <derived name="PATH_RECIPE_REF"/>
              </type>
            </variable>
            <variable name="PowerX">
              <type>
                <derived name="MC_Power"/>
              </type>
            </variable>
            <variable name="PowerY">
              <type>
                <derived name="MC_Power"/>
              </type>
            </variable>
            <variable name="GroupEnable">
              <type>
                <derived name="MC_GroupEnable"/>
              </type>
            </variable>
            <variable name="CoordinatedPath">
