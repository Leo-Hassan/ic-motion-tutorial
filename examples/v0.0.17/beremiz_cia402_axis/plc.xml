  <types><dataTypes/><pous><pou name="MAIN" pouType="program">
    <interface>
      <externalVars><variable name="Axis_1"><type><derived name="AXIS_REF"/></type></variable></externalVars>
      <localVars>
        <variable name="Power"><type><derived name="MC_Power"/></type></variable>
        <variable name="Reset"><type><derived name="MC_Reset"/></type></variable>
        <variable name="Home"><type><derived name="MC_Home"/></type></variable>
        <variable name="MoveAbs"><type><derived name="MC_MoveAbsolute"/></type></variable>
        <variable name="Stop"><type><derived name="MC_Stop"/></type></variable>
        <variable name="Enable"><type><BOOL/></type></variable>
        <variable name="ResetFault"><type><BOOL/></type></variable>
        <variable name="DeviceHome"><type><BOOL/></type></variable>
        <variable name="StartMove"><type><BOOL/></type></variable>
        <variable name="StopRequest"><type><BOOL/></type></variable>
      </localVars>
    </interface>
    <body><ST><xhtml:p><![CDATA[Power(Axis := Axis_1, Enable := Enable);
Reset(Axis := Axis_1, Execute := ResetFault);
Home(Axis := Axis_1, Execute := DeviceHome);
MoveAbs(Axis := Axis_1, Execute := StartMove, Position := 1.0,
        Velocity := 0.1, Acceleration := 0.2, Deceleration := 0.2);
Stop(Axis := Axis_1, Execute := StopRequest);
]]></xhtml:p></ST></body>
  </pou></pous></types>
  <instances><configurations><configuration name="Config0"><resource name="Resource0">
