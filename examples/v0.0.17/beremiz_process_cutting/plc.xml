        <body>
          <ST>
            <xhtml:p><![CDATA[PowerTracking(Axis := TrackingAxis, Enable := AxisEnable);
PowerSaw(Axis := SawAxis, Enable := AxisEnable);
PowerKnife(Axis := KnifeAxis, Enable := AxisEnable);

IF UseBadTrackingRecipe THEN
    ActiveTrackingRecipe := 0;
ELSIF UseUnreachableTrackingRecipe THEN
    ActiveTrackingRecipe := Recipe_Unreachable;
ELSE
    ActiveTrackingRecipe := Recipe_Tracking;
END_IF;

TrackingCut(Master := Master, Slave := TrackingAxis,
            Recipe := ActiveTrackingRecipe, Enable := TrackingRequest,
            Mark := TrackingMark, ProcessEnable := TrackingProcessEnable);
FlyingSaw(Master := Master, Slave := SawAxis,
          Recipe := Recipe_Saw, Enable := SawRequest,
          Mark := SawMark, ProcessEnable := SawProcessEnable);
RotaryKnife(Master := Master, Slave := KnifeAxis,
            Recipe := Recipe_Knife, Enable := KnifeRequest,
            Mark := KnifeMark, ProcessEnable := KnifeProcessEnable);
]]></xhtml:p>
          </ST>
        </body>
