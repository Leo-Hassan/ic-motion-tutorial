            <variable name="CamAmplitude">
              <type>
                <LREAL/>
              </type>
              <initialValue>
                <simpleValue value="0.5"/>
              </initialValue>
            </variable>
            <variable name="State">
              <type>
                <UINT/>
              </type>
            </variable>
            <variable name="Done">
              <type>
                <BOOL/>
              </type>
            </variable>
            <variable name="Error">
              <type>
                <BOOL/>
              </type>
            </variable>
            <variable name="ErrorID">
              <type>
                <UDINT/>
              </type>
            </variable>
            <variable name="AxisMove">
              <type>
                <derived name="MC_MoveAbsolute"/>
              </type>
            </variable>
          </localVars>
        </interface>
        <body>
          <ST>
            <xhtml:p><![CDATA[(* Motion Preview: offline VirtualAxis, fixed 1 ms. *)
(* Edit parameters in the variable table; edit this ST freely. *)
PowerX(Axis := AxisX, Enable := NOT Error);
IF (State = 0) AND PowerX.Status THEN State := 10; END_IF;
AxisMove(Axis := AxisX, Execute := State = 10,
     Position := Distance, Velocity := Velocity, Acceleration := 20.0, Deceleration := 20.0);
IF AxisMove.Done THEN State := 30; END_IF;
Done := State = 30;
ReadX(Axis := AxisX, Enable := TRUE);
AxisXTrace(Axis := AxisX, Enable := TRUE, Reset := FALSE, ReadIndex := 0);
IF PowerX.Error AND NOT Error THEN Error := TRUE; ErrorID := PowerX.ErrorID; END_IF;
IF ReadX.Error AND NOT Error THEN Error := TRUE; ErrorID := ReadX.ErrorID; END_IF;
IF AxisMove.Error AND NOT Error THEN Error := TRUE; ErrorID := AxisMove.ErrorID; END_IF;
]]></xhtml:p>
          </ST>
        </body>
      </pou>
